{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Generic, account-independent config (safe to publish).
  //  * "Deploy to Cloudflare" button: the D1 database below is created for you and its id replaced.
  //  * scripts/deploy.sh (CLI / GitHub Actions): finds or creates the database by name and writes a
  //    git-ignored wrangler.deploy.jsonc with the real id; this file is never modified.
  // Secrets (prompted by the button, generated by scripts/deploy.sh): ENCRYPTION_KEY, SESSION_SECRET, SETUP_TOKEN.
  // Optional: ADMIN_PASSWORD_HASH (overrides the password created in first-run setup),
  //           ENCRYPTION_KEY_VERSION, ENCRYPTION_KEY_PREVIOUS ("v<n>:<old key>"),
  //           ACCESS_TEAM_DOMAIN + ACCESS_AUD (with AUTH_MODE "access" or "both").
  // NEVER set DEV_ALLOW_PRIVATE_TARGETS / DEV_INSECURE_COOKIES in production (local .dev.vars only).
  "name": "cf-ssh-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-ssh-mcp-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SSH_SESSION", "class_name": "SshSession" },
      { "name": "MCP_SESSION", "class_name": "McpSession" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SshSession", "McpSession"] }
  ],
  "vars": {
    "AUTH_MODE": "password"
  }
}
